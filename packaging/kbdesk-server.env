# KB-Desk relay TLS configuration (system service: kbdesk-server)
#
# TLS is mandatory: the relay refuses to start without a certificate.
# Point these at PEM files readable by the service account — e.g. the
# launcher-generated set (create once with:
#   cd /etc/kbdesk && sudo kbdesk relay --tls-dir tls   # Ctrl-C after start
# which leaves tls/{ca,cert,key}.pem), Let's Encrypt, or corporate PKI:
#
KB_DESK_TLS_CERT=/etc/kbdesk/tls/cert.pem
KB_DESK_TLS_KEY=/etc/kbdesk/tls/key.pem
#
# Local development only (NOT for production): KB_DESK_TLS_CERT/KEY may be
# omitted if you instead add --allow-plaintext to the unit's ExecStart.
