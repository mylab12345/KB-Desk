# KB-Desk web viewer configuration
# Word-split into arguments for kbdesk-web.
#
# Serve on a custom port:
#   KB_DESK_WEB_ARGS=--listen 0.0.0.0:8080
#
# Let visitors connect with only an ID + password (recommended):
#   KB_DESK_WEB_ARGS=--listen 0.0.0.0:8080 --relay relay.example.com:21118
#
KB_DESK_WEB_ARGS=--listen 0.0.0.0:8080
