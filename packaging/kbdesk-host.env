# KB-Desk host agent configuration (user service)
# Copy to ~/.config/kbdesk/host.env and edit.

# Relay/rendezvous server the host registers with (required).
KB_DESK_SERVER=relay.example.com:21118

# Session password viewers must supply (required).
KB_DESK_PASSWORD=change-me

# Frames per second (optional).
KB_DESK_FPS=15
