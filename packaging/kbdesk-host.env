# KB-Desk host agent configuration (user service)
# Copy to ~/.config/kbdesk/host.env and edit.

# Relay/rendezvous server the host registers with (required).
KB_DESK_SERVER=relay.example.com:21118

# Session password viewers must prove (required). It is never transmitted —
# it is bound into the end-to-end key exchange — but it is still the thing
# standing between the internet and this desktop: make it long and unique.
KB_DESK_PASSWORD=change-me

# CA certificate used to verify the relay's TLS (needed when the relay uses
# the launcher-generated CA or a corporate CA; copy ca.pem from the relay).
# Omit when the relay has a publicly trusted certificate.
#KB_DESK_TLS_CA=/home/you/.config/kbdesk/ca.pem

# Expected name in the relay's certificate, if it differs from the host you
# dial (e.g. you dial an IP but the certificate is for kb.example.com).
#KB_DESK_TLS_SERVER_NAME=kb.example.com

# Frames per second (optional).
KB_DESK_FPS=15
